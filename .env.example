# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encryption (32+ char secret for token storage)
ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# OpenAI (optional — paid). Leave empty to use FREE local ad copy.
OPENAI_API_KEY=
# Set true only if you want paid DALL·E images
USE_OPENAI_IMAGES=false

# Groq (optional FREE LLM — https://console.groq.com , no card for free tier)
GROQ_API_KEY=

# Meta OAuth (requires registered Meta App with Marketing API)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback
META_PAGE_ID=

# Meta Ad Library (competitor live ads)
# Optional token for Graph ads_archive (often empty for India-only commercial ads)
META_AD_LIBRARY_TOKEN=
# Web Library fetch via Playwright (default on). Set false to disable.
META_AD_LIBRARY_WEB_FETCH=true
# After npm install: npx playwright install chromium

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_PLAN_STARTER=plan_xxxxx
RAZORPAY_PLAN_GROWTH=plan_xxxxx
RAZORPAY_PLAN_SCALE=plan_xxxxx

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Email digests & policy alerts (Resend). Leave empty to log stubs.
RESEND_API_KEY=
EMAIL_FROM=AdForge <reports@yourdomain.com>

# WhatsApp Business API (optional — not used for reporting)
WHATSAPP_API_KEY=

# Meta Policy Guard pack version (bump when norms change)
META_POLICY_PACK_VERSION=v1

# Default ad link for Meta creatives
DEFAULT_AD_LINK=https://yourstore.com
