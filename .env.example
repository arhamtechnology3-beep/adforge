# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails with lifetime access (no trial expiry)
ADMIN_EMAILS=jesalp85@gmail.com
# Hostinger: set SKIP_PLAYWRIGHT=1 to skip Chromium download during npm install
# SKIP_PLAYWRIGHT=1

# Encryption (32+ char secret for token storage)
ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# OpenAI (optional — paid). Leave empty to use FREE local ad copy.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
# Set true only if you want paid DALL·E images
USE_OPENAI_IMAGES=false

# Arham Cloudflare Worker — sole image generation API
# POST { prompt } with Bearer token → raw JPEG bytes
ARHAM_IMAGE_API_URL=https://image-api.arhamtechnology3.workers.dev
ARHAM_IMAGE_API_TOKEN=

# OpenRouter — optional (disabled for scene images; Arham is sole image provider)
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# Cloudflare Workers AI — legacy (unused for scenes; Arham worker is used instead)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Pollinations — legacy optional fallback (unused for scenes)
POLLINATIONS_API_KEY=

# Puter BYOP — optional user-pays provider path
PUTER_BYOP_ENABLED=false

# Fal.ai FLUX: high-quality scene backgrounds; approved packshot is composited afterward
FAL_KEY=

# remove.bg — professional packshot background removal (primary when set)
REMOVE_BG_API_KEY=

# FreeLLMAPI — free image & video generation via OpenAI-compatible /v1 endpoint
# One-shot install (no Docker): npm run install:freellmapi
# Or official script: curl -fsSL https://freellmapi.co/install.sh | bash
# After install, FREELLM_API_KEY is written to .env.local automatically.
# For Cloudflare FLUX (free tier), set CLOUDFLARE_ACCOUNT_ID from dashboard
# (Workers AI token is IP-restricted — auto-lookup may fail off-network).
# Optional: POLLINATIONS_API_KEY from https://enter.pollinations.ai/keys
FREELLM_API_KEY=
FREELLM_API_BASE_URL=http://localhost:3001/v1
FREELLM_IMAGE_MODEL=auto
FREELLM_VIDEO_MODEL=auto

# Motion video (optional override; bundled ffmpeg-static is used by default)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Groq (optional FREE LLM — https://console.groq.com , no card for free tier)
GROQ_API_KEY=

# Meta OAuth (requires registered Meta App with Marketing API)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback
# Optional override — normally auto-filled from Facebook Pages on Connect
META_PAGE_ID=

# Meta Ad Library (competitor live ads)
# Optional token for Graph ads_archive (often empty for India-only commercial ads)
META_AD_LIBRARY_TOKEN=
# Web Library fetch via Playwright (default on). Set false to disable.
META_AD_LIBRARY_WEB_FETCH=true
# After npm install: npx playwright install chromium (also runs via postinstall)
# Optional override — auto-written to scripts/chromium-path.txt on postinstall
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_PLAN_STARTER=plan_xxxxx
RAZORPAY_PLAN_GROWTH=plan_xxxxx
RAZORPAY_PLAN_SCALE=plan_xxxxx

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Email digests & policy alerts (Resend). Leave empty to log stubs.
RESEND_API_KEY=
EMAIL_FROM=AdForge <reports@yourdomain.com>

# WhatsApp Business API (optional — not used for reporting)
WHATSAPP_API_KEY=

# Meta Policy Guard pack version (bump when norms change)
META_POLICY_PACK_VERSION=v1

# Default ad link for Meta creatives
DEFAULT_AD_LINK=https://yourstore.com
